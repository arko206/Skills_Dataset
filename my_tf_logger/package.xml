<?xml version="1.0"?>
<package format="3">
  <name>my_tf_logger</name>
  <version>0.0.1</version>
  <description>Logs a TF as a 4x4 matrix each timestep.</description>
  <maintainer email="arka@example.com">arka</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-zarr</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-tqdm</exec_depend>
  <exec_depend>python3-gdown</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

